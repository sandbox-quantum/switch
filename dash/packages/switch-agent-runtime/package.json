{
  "name": "@sandbox-quantum/switch-agent-runtime",
  "version": "0.1.6",
  "description": "Switch agent protocol client, and the local MCP runtime built on it",
  "license": "Apache-2.0",
  "author": {
    "name": "Switch Contributors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandbox-quantum/switch.git",
    "directory": "dash/packages/switch-agent-runtime"
  },
  "bin": {
    "switch-agent-runtime": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "lint": "sh -c 'root=$(cd ../.. && pwd); cd \"$root/apps/switchdash-desktop\" && pnpm exec oxlint --config .oxlintrc.json \"$root/packages/switch-agent-runtime\"'",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
