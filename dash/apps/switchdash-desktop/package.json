{
  "name": "@switchdash/switchdash-desktop",
  "version": "0.8.8",
  "description": "A cross-platform Electron app that orchestrates multiple coding agents in parallel",
  "keywords": [
    "claude",
    "coding-agents",
    "electron",
    "git",
    "openai"
  ],
  "homepage": "https://github.com/sandbox-quantum/switch",
  "license": "Apache-2.0",
  "author": {
    "name": "Switchdash Contributors"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "d": "pnpm install && pnpm run dev",
    "dev": "electron-vite dev",
    "dev:debug": "VITE_LOG_LEVEL=debug electron-vite dev",
    "dev:main": "electron-vite dev --watch main",
    "dev:renderer": "electron-vite dev --watch renderer",
    "db:generate": "drizzle-kit generate",
    "db:setup": "npm install --prefix tooling/node-deps",
    "db:fixtures": "vitest run --project fixtures",
    "test:migrations": "vitest run --project migrations",
    "db:reset": "rm -f \"$HOME/Library/Application Support/switchdash-dev/switchdash.db\" \"$HOME/Library/Application Support/switchdash-dev/switchdash.db-wal\" \"$HOME/Library/Application Support/switchdash-dev/switchdash.db-shm\" \"$HOME/.config/switchdash-dev/switchdash.db\" \"$HOME/.config/switchdash-dev/switchdash.db-wal\" \"$HOME/.config/switchdash-dev/switchdash.db-shm\"",
    "test": "vitest run --project node --project main-db --project migrations --project browser",
    "build": "electron-vite build && pnpm run build:sidecar",
    "build:main": "electron-vite build --filter main",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:renderer": "electron-vite build --filter renderer",
    "package": "pnpm run build && electron-builder --config electron-builder.config.ts",
    "package:mac": "pnpm run build && electron-builder --mac --config electron-builder.config.ts",
    "package:linux": "pnpm run build && electron-builder --linux --publish never --config electron-builder.config.ts",
    "package:win": "pnpm run build && electron-builder --win --publish never --config electron-builder.config.ts",
    "postinstall": "node --experimental-strip-types scripts/postinstall.ts",
    "rebuild": "electron-rebuild -f -v 40.7.0 --only=better-sqlite3,node-pty",
    "deeplink:reset": "node --experimental-strip-types scripts/reset-deeplink-handler.ts",
    "clean": "rm -rf node_modules dist",
    "reset": "pnpm run clean && pnpm install",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit",
    "docs": "cd docs && pnpm run dev",
    "docs:build": "cd docs && pnpm run build"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.6",
    "@switchdash/core": "workspace:*",
    "@switchdash/plugins": "workspace:*",
    "@switchdash/shared": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "better-sqlite3": "^12.11.1",
    "croner": "^10.0.1",
    "cronstrue": "^3.24.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.3.9",
    "glob": "^13.0.6",
    "human-id": "^4.1.2",
    "ignore": "^7.0.5",
    "jsonc-parser": "^3.3.1",
    "nbranch": "^0.1.1",
    "node-pty": "1.1.0",
    "pidusage": "^4.0.1",
    "smol-toml": "^1.7.0",
    "ssh2": "^1.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-form": "^1.28.4",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.1",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/browser-preview": "^4.1.10",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.3",
    "date-fns": "^4.1.0",
    "devicon": "^2.17.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "framer-motion": "^12.42.2",
    "jsdom": "^29.0.2",
    "katex": "^0.17.0",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.16.0",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "monaco-editor": "^0.55.1",
    "motion": "^12.42.2",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "postcss": "^8.5.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.1",
    "react-syntax-highlighter": "^16.1.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "s3mini": "^0.9.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.1.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.28.0"
  }
}
