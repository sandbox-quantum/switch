{
  "name": "switchdash-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --filter './packages/**' run build && pnpm --filter @switchdash/switchdash-desktop run build:sidecar && pnpm -r --parallel --filter './packages/**' --filter @switchdash/switchdash-desktop run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "typecheck": "pnpm -r run typecheck",
    "deeplink:reset": "pnpm --filter @switchdash/switchdash-desktop run deeplink:reset"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.28.0"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "core-js",
      "electron",
      "esbuild",
      "node-pty",
      "protobufjs",
      "sqlite3"
    ],
    "overrides": {
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9 <6",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0 <5",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5 <4",
      "tar@<=7.5.20": ">=7.5.21 <8"
    }
  }
}
