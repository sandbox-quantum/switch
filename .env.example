# Switch local development configuration
#
# Do NOT copy this file to .env by hand: the secret fields below ship BLANK on
# purpose so no known default credential ever reaches a running stack. Generate
# a .env with strong random secrets instead:
#
#   just init-env
#
# That fills every blank secret (admin passwords, DB password, JWT key, Matrix
# registration secret, agent token) with a freshly generated value and prints
# the resulting gateway admin login.

# ── Standalone images (GHCR) ─────────────────────────────────────────────────
# Coordinates for the published switch-core / gateway / setup images that the
# standalone stack pulls. Set SWITCH_VERSION to a released tag (e.g. 0.3.0) for
# a reproducible stack. It is REQUIRED and has no default in the compose file:
# it used to fall back to `latest`, so a missing or misspelt value silently
# floated the whole stack to whatever had most recently been published, with
# nothing to say so. Compose now refuses to start instead.
# Repo users building from source (`just standalone-up`) can ignore these.
SWITCH_REGISTRY=ghcr.io
SWITCH_IMAGE_NAMESPACE=sandbox-quantum
SWITCH_VERSION=latest
# Host ports each service publishes. Defaults match the values baked in before
# these knobs existed; override any that clash with something already running on
# your machine (Switch Console's local-server mode picks free ports automatically).
GATEWAY_HOST_PORT=3000
API_HOST_PORT=8000
MATTERMOST_HOST_PORT=8065
POSTGRES_HOST_PORT=5432
# Host interface the published ports bind to. Defaults to loopback so the stack
# is reachable only from this machine; set to 0.0.0.0 to expose it on the
# network — do that only behind a reverse proxy / firewall.
SWITCH_BIND_ADDR=127.0.0.1

# ── Switch database (docker compose) ──────────────────────────────────────────
# Two roles, not one, because row-level security is inert against the role
# that owns the tables it protects — Postgres exempts a table's owner from its
# own policies. So DB_USER below is deliberately NOT the owner:
#
#   DB_USER / DB_PASSWORD   the RUNTIME role. Every request switch-core serves
#                           authenticates as this role, so it is the one the
#                           tenant-isolation policies actually apply to. It is
#                           a plain LOGIN role that owns nothing and can
#                           create nothing — `just up`'s init-db container
#                           creates it, and switch-core grants it CRUD on the
#                           schema at boot, once the owner connection has run
#                           migrations.
#   DB_OWNER_USER / DB_OWNER_PASSWORD
#                           the SCHEMA OWNER, used for exactly two things:
#                           running Alembic at boot, and re-issuing the
#                           runtime role's grants right after. It is never
#                           used to serve a request. The container's Postgres
#                           superuser is this role now, not DB_USER — see
#                           deploy/local/docker-compose.yml.
#
# If DB_USER were the owner, switch-core would refuse to start:
# DB_REQUIRE_RESTRICTED_ROLE (default true) checks the runtime connection is
# not a superuser, does not bypass RLS, and owns no policied table, precisely
# because a deployment that believes it is isolating tenants and is not looks
# identical to one that is, until a second tenant reads the first's rooms.
DB_HOST=localhost
DB_PORT=5432
DB_USER=switch_app
DB_PASSWORD=
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=
DB_NAME=switch

# TLS for the Postgres connection: disable | allow | prefer | require |
# verify-ca | verify-full. Local dev and an in-cluster database stay plain;
# a managed database (RDS / Cloud SQL / Azure) needs at least "require".
# DB_SSL_MODE=disable
# PEM bundle of certificate authorities the server certificate is checked
# against. Only for the two verifying modes, and needed there because a managed
# database is signed by the provider's own root rather than a public one.
# DB_SSL_ROOT_CERT=/etc/ssl/certs/rds-global-bundle.pem

# ── Logging ──────────────────────────────────────────────────────────────────
# "text" for a terminal, "json" for a log pipeline that parses fields.
# LOG_FORMAT=text
# LOG_LEVEL=INFO
# SWITCH_LOG_LEVEL=INFO
# Emitted on every JSON line as `service` / `env`.
# SERVICE_NAME=switch-core
# ENVIRONMENT=development
# What a log line says when no tenant is bound to it. A request logs the
# caller's tenant and background work logs the tenant of the row it is acting
# on, so this only covers lines belonging to neither — which are also the lines
# that can write nothing. Not a tenant id, and setting it to one would make
# every unattributed line look like that tenant's own.
# TENANT_ID=default

# ── Client identity ──────────────────────────────────────────────────────────
# The server half of every client's `@localpart:server` id. Nothing is
# contacted at it; the ids are stable public handles.
MATRIX_SERVER_NAME=localhost

# ── Agent registration ───────────────────────────────────────────────────────
AGENT_REGISTRATION_TOKEN=

# ── Gateway auth ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
GATEWAY_ADMIN_EMAIL=admin@switch.local
GATEWAY_ADMIN_PASSWORD=

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173

# Public origin of the gateway HTTP API (used to build the switchdash:// deeplink
# HTTP redirect so "Open in Switch Console" is clickable on Discord, Telegram
# and other http-only platforms). Leave unset to post the raw switchdash://
# deeplink.
# GATEWAY_PUBLIC_URL=http://localhost:8000

# ── Mattermost (local dev) ───────────────────────────────────────────────────
MATTERMOST_ADMIN_USER=admin
MATTERMOST_ADMIN_PASSWORD=
MATTERMOST_TEAM_NAME=switch
MATTERMOST_USER=user
MATTERMOST_USER_PASSWORD=

# Teams and Telegram have no local-dev env vars: both are connected per-bridge
# through the gateway (all credentials live in the bridge's stored
# connection_config), never in global config.

# ── Session activity and request cards (local dev) ───────────────────────────
# No agent host speaks the session interaction contract yet, so no session's
# activity can reach a channel. With this set, `!session-demo` in a bridged
# Slack channel posts a recorded turn there — what the agent did and said, and
# then the permission it stopped to ask for, as a real card — so the answer
# path can be exercised against a real workspace. Needs the repository
# checkout, for the fixtures.
# SESSION_DEMO_ENABLED=true

# ── OIDC (optional — MCP OAuth token validation; bring your own IdP) ─────────
# Enable OAuth/OIDC token auth on the MCP server by pointing at any standards
# compliant IdP. Leave unset to use API-token (bearer) auth only, which is the
# default for the local stack.
# OAUTH_ISSUER_URL=https://your-idp.example.com/realms/switch
# OAUTH_AUDIENCE=switch
# OAUTH_VERIFY_ISSUER=true

# ── Gateway OIDC login (optional — bring your own IdP for the browser login;
# distinct from the OAUTH_* block above) ──────────────────────────────────────
# See docs/old/GATEWAY_OIDC_SETUP.md before setting these, especially if the
# provider is WorkOS: it needs a Connect application, not a User Management
# client id. Issuer/client id/secret are all-or-nothing — set all three or
# none. Quote GATEWAY_OIDC_SCOPES; it must include "openid" or no id_token is
# issued.
# GATEWAY_OIDC_ISSUER_URL=https://<your-idp-or-authkit-domain>
# GATEWAY_OIDC_CLIENT_ID=<client-id>
# GATEWAY_OIDC_CLIENT_SECRET=<client-secret>
# GATEWAY_OIDC_SCOPES="openid profile email"
# GATEWAY_OIDC_PROVIDER_LABEL=SSO
# GATEWAY_OIDC_REDIRECT_URL=http://localhost:8000/gateway/auth/oidc/callback
# GATEWAY_OIDC_REQUIRE_EMAIL_VERIFIED=true
