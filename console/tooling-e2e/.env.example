# Copy to .env (gitignored) and fill in. Never commit real values.
# `just e2e-fast` needs none of this: it sets everything for its own stack.

# fast | provider. Unset, every end-to-end scenario skips.
SWITCH_E2E_LANE=fast
# ephemeral | local | dev | staging | prod. prod is read-only for the harness.
SWITCH_E2E_ENVIRONMENT=local

SWITCH_API_URL=http://127.0.0.1:8000
SWITCH_GATEWAY_ADMIN_EMAIL=admin@switch.local
SWITCH_GATEWAY_ADMIN_PASSWORD=
SWITCH_AGENT_REGISTRATION_TOKEN=

# Provider lane only. Working directory of the session under test — the harness
# writes the agent's credentials to <dir>/.switch/agents/<agent-name>.json when set.
# SWITCH_E2E_AGENT_DIR=
