# Copy to .env (gitignored) and fill in. Never commit real values.
SWITCH_API_URL=http://127.0.0.1:54111
SWITCH_GATEWAY_ADMIN_EMAIL=admin@switch.local
SWITCH_GATEWAY_ADMIN_PASSWORD=
SWITCH_AGENT_REGISTRATION_TOKEN=

MATTERMOST_URL=http://127.0.0.1:54112
MATTERMOST_TOKEN=
MATTERMOST_TEAM=switch

# Optional. Working directory of the session under test — the harness writes the
# agent's credentials to <dir>/.switch/agents/<agent-name>.json when set.
# SWITCH_E2E_AGENT_DIR=
