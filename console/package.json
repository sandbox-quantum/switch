{
  "name": "switch-console-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --filter './packages/**' run build && pnpm --filter @switch-console/desktop run build:sidecar && pnpm -r --parallel --filter './packages/**' --filter @switch-console/desktop run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "typecheck": "pnpm -r run typecheck",
    "deeplink:reset": "pnpm --filter @switch-console/desktop run deeplink:reset"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.28.0"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "core-js",
      "electron",
      "esbuild",
      "protobufjs",
      "sqlite3"
    ],
    "overrides": {
      "body-parser@>=2.0.0 <2.4.0": ">=2.4.0 <3",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12 <6",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5",
      "fast-uri@>=3.0.0 <3.1.9": ">=3.1.9 <4",
      "proxy-addr@<2.0.8": ">=2.0.8 <3",
      "tar@<=7.5.20": ">=7.5.21 <8"
    }
  }
}
