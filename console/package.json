{
  "name": "switch-console-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --filter './packages/**' run build && pnpm --filter @switch-console/desktop run build:sidecar && pnpm -r --parallel --filter './packages/**' --filter @switch-console/desktop run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "typecheck": "pnpm -r run typecheck",
    "deeplink:reset": "pnpm --filter @switch-console/desktop run deeplink:reset"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.28.0"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "core-js",
      "electron",
      "esbuild",
      "protobufjs",
      "sqlite3"
    ],
    "overrides": {
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5 <4",
      "tar@<=7.5.20": ">=7.5.21 <8",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12 <6",
      "esbuild@<=0.24.2": ">=0.25.0 <0.26",
      "prismjs@<1.30.0": ">=1.30.0 <2",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6 <5",
      "undici@<6.29.1": ">=6.29.1 <7",
      "undici@>=7.0.0 <7.30.1": ">=7.30.1 <8",
      "shell-quote@<1.11.0": ">=1.11.0 <2",
      "dompurify@<3.4.17": ">=3.4.17 <4",
      "brace-expansion@<1.1.21": ">=1.1.21 <2",
      "brace-expansion@>=2.0.0 <2.1.7": ">=2.1.7 <3",
      "browserslist@<4.28.7": ">=4.28.7 <5",
      "@xmldom/xmldom@>=0.7.0 <0.8.15": ">=0.8.15 <0.9",
      "fast-uri@>=3.0.0 <3.1.9": ">=3.1.9 <4",
      "baseline-browser-mapping@<2.11.0": ">=2.11.0 <3",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2 <2",
      "glob@>=9.0.0 <14.0.2": ">=14.0.2 <15",
      "minimatch@>=7.0.0 <11.0.1": ">=11.0.1 <12",
      "katex@<0.19.0": "^0.19.1"
    }
  }
}
