{
  "name": "@switch-console/agent-controller",
  "version": "0.2.0",
  "private": true,
  "description": "Headless agents controller: runs the Switch agents assigned to this machine and reports their status",
  "license": "Apache-2.0",
  "author": {
    "name": "Switch Console Contributors"
  },
  "bin": {
    "switch-agent-controller": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "lint": "sh -c 'root=$(cd ../.. && pwd); cd \"$root/apps/switch-console-desktop\" && pnpm exec oxlint --config .oxlintrc.json \"$root/packages/agent-controller\"'",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@switch-console/agent-providers": "workspace:*",
    "@switch-console/plugins": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sandboxaq/switch-agent-runtime": "workspace:*",
    "@types/node": "^24.13.3",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "tsdown": "^0.22.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
