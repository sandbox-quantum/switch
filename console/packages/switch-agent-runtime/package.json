{
  "name": "@sandboxaq/switch-agent-runtime",
  "version": "0.8.0",
  "private": true,
  "description": "Switch agent protocol client, and the Switch tool surface a session host serves",
  "license": "Apache-2.0",
  "author": {
    "name": "Switch Contributors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandbox-quantum/switch.git",
    "directory": "console/packages/switch-agent-runtime"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./hosted": {
      "types": "./dist/hosted.d.mts",
      "default": "./dist/hosted.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "lint": "sh -c 'root=$(cd ../.. && pwd); cd \"$root/apps/switch-console-desktop\" && pnpm exec oxlint --config .oxlintrc.json \"$root/packages/switch-agent-runtime\"'",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "tsdown": "^0.22.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
