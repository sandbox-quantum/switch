# Local development only.
#
# Vite serves the bundle directly with `just gateway-dev`, so there is no
# container entrypoint to write the runtime config — this stands in for it.
# Deployments configure the key at runtime instead: `gateway.muiLicenseKey` in
# the Helm chart, or MUI_X_LICENSE_KEY on the container. See ./README.md.
#
# Copy this file to `gateway/.env` (gitignored) and fill in the key. Never
# commit it: this repository is the source of the open-source release artifacts.
VITE_MUI_X_LICENSE_KEY=
