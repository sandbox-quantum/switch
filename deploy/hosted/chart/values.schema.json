{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "serviceAccount",
    "persistence",
    "controllerConfig"
  ],
  "properties": {
    "gatewaySecretName": { "type": "string" },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": [
        "name",
        "roleArn"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roleArn": {
          "type": "string",
          "pattern": "^arn:aws[^:]*:iam::[0-9]{12}:role/.+$"
        }
      }
    },
    "controllerConfig": {
      "type": "object",
      "required": [
        "installation_id",
        "region",
        "availability_zone",
        "subnet_id",
        "security_group_ids",
        "image_id",
        "root_device_name",
        "allowed_instance_types",
        "max_machines",
        "root_volume_gib",
        "data_volume_gib",
        "machine_slots",
        "poll_interval_seconds",
        "login_kms_key_arn"
      ],
      "properties": {
        "image_id": {
          "type": "string",
          "pattern": "^ami-[0-9a-f]{8,17}$"
        },
        "login_kms_key_arn": {
          "type": "string",
          "pattern": "^arn:aws[^:]*:kms:[a-z0-9-]+:[0-9]{12}:key/.+$"
        },
        "machine_slots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "instance_profile_arn",
              "assignment_secret_arn",
              "role_arn"
            ],
            "properties": {
              "instance_profile_arn": {
                "type": "string",
                "pattern": "^arn:aws[^:]*:iam::[0-9]{12}:instance-profile/.+$"
              },
              "assignment_secret_arn": {
                "type": "string",
                "pattern": "^arn:aws[^:]*:secretsmanager:.+$"
              },
              "role_arn": {
                "type": "string",
                "pattern": "^arn:aws[^:]*:iam::[0-9]{12}:role/.+$"
              }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        }
      }
    }
  }
}
