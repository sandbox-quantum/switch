[Unit]
Description=Mount this Switch cloud machine's data volume and start its agents controllers
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -I /usr/local/libexec/switch-machine-boot
TimeoutStartSec=20min
Restart=on-failure
RestartSec=30s
RestartPreventExitStatus=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
