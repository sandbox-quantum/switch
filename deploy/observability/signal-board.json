{
  "title": "Switch signal",
  "description": "Pilot at a glance: the four golden signals plus agents and messaging apps. Kept in deploy/observability/signal-board.json; edit it there.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "**Pilot at a glance.** Each tile answers one question. Everything is grey while it's normal; a value turns red, and a dashed red line marks the limit an alert watches. Causes and detail: **Switch: core service health** and **core across pods**. Alerts post to Slack #switch-alert-hub.",
        "background_color": "white",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false,
        "has_padding": true
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 1
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Are agents connected?",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "agents connected now",
              "title_size": "13",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:switch.agents.connected{service:switch-core}",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "custom_text",
                      "custom_fg_color": "#5b6672"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "connected agents",
              "title_size": "13",
              "show_legend": false,
              "legend_layout": "horizontal",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "q",
                      "alias": "connected"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:switch.agents.connected{service:switch-core}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "grey",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "markers": [],
              "yaxis": {
                "min": "0",
                "include_zero": true
              }
            },
            "layout": {
              "x": 0,
              "y": 2,
              "width": 4,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 1,
        "width": 4,
        "height": 6
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Are the messaging apps up?",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "bridges healthy (1 = all running)",
              "title_size": "13",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "min:switch.health.check{service:switch-core,check:bridges}",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": "<",
                      "value": 1,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">=",
                      "value": 1,
                      "palette": "custom_text",
                      "custom_fg_color": "#5b6672"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "bridges running, by platform",
              "title_size": "13",
              "show_legend": false,
              "legend_layout": "horizontal",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "q",
                      "alias": "running"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:switch.bridges.running{service:switch-core} by {platform}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "grey",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "markers": [],
              "yaxis": {
                "min": "0",
                "include_zero": true
              }
            },
            "layout": {
              "x": 0,
              "y": 2,
              "width": 4,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 4,
        "y": 1,
        "width": 4,
        "height": 6
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Latency: is it fast?",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "API p95, last hour",
              "title_size": "13",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "p95:switch.http.request.duration{service:switch-core}",
                      "aggregator": "avg"
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 2000,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": "<=",
                      "value": 2000,
                      "palette": "custom_text",
                      "custom_fg_color": "#5b6672"
                    }
                  ]
                }
              ],
              "custom_unit": "ms"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "p95 in ms: API requests and message delivery",
              "title_size": "13",
              "show_legend": true,
              "legend_layout": "horizontal",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "q",
                      "alias": "API p95"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "p95:switch.http.request.duration{service:switch-core}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "grey",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                },
                {
                  "formulas": [
                    {
                      "formula": "q",
                      "alias": "delivery p95"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "p95:switch.messages.delivery_lag{service:switch-core}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "grey",
                    "line_type": "dotted",
                    "line_width": "normal"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 2000",
                  "display_type": "error dashed",
                  "label": "API alert"
                }
              ],
              "yaxis": {
                "min": "0",
                "include_zero": true
              }
            },
            "layout": {
              "x": 0,
              "y": 2,
              "width": 4,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 8,
        "y": 1,
        "width": 4,
        "height": 6
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Traffic: how busy?",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "requests per second",
              "title_size": "13",
              "autoscale": true,
              "precision": 1,
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:switch.http.requests{service:switch-core}.as_rate()",
                      "aggregator": "avg"
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "custom_text",
                      "custom_fg_color": "#5b6672"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "requests per second, against the same time last week",
              "title_size": "13",
              "show_legend": true,
              "legend_layout": "horizontal",
              "legend_columns": [
                "avg",
                "value"
              ],
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "q",
                      "alias": "now"
                    },
                    {
                      "formula": "week_before(q)",
                      "alias": "last week"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:switch.http.requests{service:switch-core}.as_rate()"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "grey",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "yaxis": {
                "min": "0",
                "include_zero": true
              }
            },
            "layout": {
              "x": 0,
              "y": 2,
              "width": 4,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 7,
        "width": 4,
        "height": 6
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Errors: is it failing?",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "server errors, last hour",
              "title_size": "13",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:switch.http.requests{service:switch-core,status_class:5xx}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 10,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": "<",
                      "value": 10,
                      "palette": "custom_text",
                      "custom_fg_color": "#5b6672"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "failures per minute",
              "title_size": "13",
              "show_legend": true,
              "legend_layout": "horizontal",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "q",
                      "alias": "server errors"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:switch.http.requests{service:switch-core,status_class:5xx}.as_count().rollup(sum, 60)"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "style": {
                    "palette": "grey",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                },
                {
                  "formulas": [
                    {
                      "formula": "q",
                      "alias": "failed deliveries"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:switch.messages.delivery_failures{service:switch-core}.as_count().rollup(sum, 60)"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "style": {
                    "palette": "grey",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                },
                {
                  "formulas": [
                    {
                      "formula": "q",
                      "alias": "failed sends"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:switch.messages.send_failures{service:switch-core}.as_count().rollup(sum, 60)"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "style": {
                    "palette": "grey",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "markers": [],
              "yaxis": {
                "min": "0",
                "include_zero": true
              }
            },
            "layout": {
              "x": 0,
              "y": 2,
              "width": 4,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 4,
        "y": 7,
        "width": 4,
        "height": 6
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Saturation: how full?",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "database connections in use, per pod (pool size 30)",
              "title_size": "13",
              "show_legend": false,
              "legend_layout": "horizontal",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "q",
                      "alias": "in use"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "max:switch.db.pool.in_use{service:switch-core} by {pod_name}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "grey",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 30",
                  "display_type": "error dashed",
                  "label": "pool size"
                }
              ],
              "yaxis": {
                "min": "0",
                "include_zero": true
              }
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "event-loop lag, worst, ms",
              "title_size": "13",
              "show_legend": false,
              "legend_layout": "horizontal",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "q",
                      "alias": "lag"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "max:switch.runtime.event_loop_lag{service:switch-core}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "grey",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "markers": [
                {
                  "value": "y = 1000",
                  "display_type": "error dashed",
                  "label": "stall alert"
                }
              ],
              "yaxis": {
                "min": "0",
                "include_zero": true
              }
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 4,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 8,
        "y": 7,
        "width": 4,
        "height": 6
      }
    }
  ],
  "template_variables": []
}
