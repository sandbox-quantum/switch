            "display_type": "bars",
            "formulas": [
              {
                "formula": "q0"
              },
              {
                "formula": "q1"
              }
            ]
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 5,
        "width": 4,
        "height": 3
      }
    },
    {
