{
  "title": "Switch — core across pods",
  "description": "switch-core per pod: is the work split, is anything doubled, how hot are the pods and the database. Source: deploy/observability/multi-pod-dashboard.json.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "default": "*"
    },
    {
      "name": "service",
      "prefix": "service",
      "default": "switch-core"
    },
    {
      "name": "pod_name",
      "prefix": "pod_name",
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "**Is work split across the pods, and is nothing doubled?** Every series is per pod (`pod_name`). With two pods, bridges, agents and pool use should split between them and sum to what one pod carried; events in vs out should keep the one-pod ratio. Pick the deployment with `env` and `service`.",
        "background_color": "blue",
        "font_size": "14",
        "text_align": "left",
        "vertical_align": "top",
        "show_tick": false,
        "has_padding": true
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 2
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Bridges running, by pod",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q0",
                "query": "sum:switch.bridges.running{$env,$service,$pod_name} by {pod_name}"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line",
            "formulas": [
              {
                "formula": "q0"
              }
            ]
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 2,
        "width": 4,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Agents connected, by pod",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q0",
                "query": "sum:switch.agents.connected{$env,$service,$pod_name} by {pod_name}"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line",
            "formulas": [
              {
                "formula": "q0"
              }
            ]
          }
        ]
      },
      "layout": {
        "x": 4,
        "y": 2,
        "width": 4,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Consumers and connectors running, by pod",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q0",
                "query": "sum:switch.consumers.running{$env,$service,$pod_name} by {pod_name}"
              },
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "sum:switch.connectors.running{$env,$service,$pod_name} by {pod_name}"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line",
            "formulas": [
              {
                "formula": "q0"
              },
              {
                "formula": "q1"
              }
            ]
          }
        ]
      },
      "layout": {
        "x": 8,
        "y": 2,
        "width": 4,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Platform events in / out",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q0",
                "query": "sum:switch.bridge.events_in{$env,$service,$pod_name}.as_count()"
              },
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "sum:switch.bridge.events_out{$env,$service,$pod_name}.as_count()"
              }
            ],
            "response_format": "timeseries",
            "display_type": "bars",
            "formulas": [
              {
                "formula": "q0"
              },
              {
                "formula": "q1"
              }
            ]
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 5,
        "width": 4,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
