FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build

WORKDIR /src/gateway
COPY gateway/package.json gateway/package-lock.json ./
RUN npm ci
# The chat UI it shares with Switch Console, compiled from source beside it.
COPY console/packages/chat-ui/ /src/console/packages/chat-ui/
COPY gateway/ .
RUN npm run build

FROM nginx:alpine
COPY --from=build /src/gateway/dist /usr/share/nginx/html
COPY deploy/shared_resources/gateway-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
