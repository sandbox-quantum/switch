FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build

WORKDIR /src/gateway
COPY gateway/package.json gateway/package-lock.json ./
RUN npm ci
# The chat UI it shares with Switch Console, compiled from source beside it.
COPY console/packages/chat-ui/ /src/console/packages/chat-ui/
# The AI providers' icons, from Switch Console's plugins.
COPY console/packages/plugins/src/agents/impl/ /src/console/packages/plugins/src/agents/impl/
COPY console/tsconfig.base.json /src/console/
COPY gateway/ .
# A dashboard test imports this Console module to check the links Console opens;
# `tsc -b` compiles tests, so it sits where that relative import expects it.
COPY console/apps/switch-console-desktop/src/shared/core/switch-servers/dashboard-pages.ts /src/console/apps/switch-console-desktop/src/shared/core/switch-servers/
RUN npm run build

FROM nginx:1.31.8-alpine@sha256:fed7e14be83cbd2661a75cdc5b872d936cf155d46c327084d30b8df19ae88d72
COPY --from=build /src/gateway/dist /usr/share/nginx/html
COPY deploy/shared_resources/gateway-nginx.conf /etc/nginx/conf.d/default.conf
# nginx runs as its own user (101) rather than starting as root: its pid file
# moves to /tmp and its cache directory becomes its own, and the `user`
# directive, which only a root master obeys, goes. Checked, so a base image
# that words nginx.conf differently fails the build instead of running as root.
RUN sed -i -e '/^user /d' -e 's,^pid .*,pid /tmp/nginx.pid;,' /etc/nginx/nginx.conf \
    && grep -q '^pid /tmp/nginx.pid;$' /etc/nginx/nginx.conf \
    && ! grep -q '^user ' /etc/nginx/nginx.conf \
    && chown -R 101:101 /var/cache/nginx
USER 101:101
EXPOSE 3000
