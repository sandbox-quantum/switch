{
 "room": {
  "name": "eng-platform",
  "instructions": "Platform team room. Deploys and CI go to deploy-bot; cloud infrastructure, databases and cloud costs go to infra-bot; customer invoices and plans go to billing-bot; customer tickets and escalations go to support-bot, who is on call; docs and release notes go to docs-bot. People here also talk among themselves; agents should not jump into those."
 },
 "agents": [
  {
   "name": "deploy-bot",
   "description": "Runs and watches CI pipelines and deployments; investigates failed builds and deploys, reruns and rolls back.",
   "role": "release"
  },
  {
   "name": "infra-bot",
   "description": "Cloud infrastructure: databases, queues, Kubernetes clusters, networking, capacity and the cloud bill."
  },
  {
   "name": "billing-bot",
   "description": "Customer billing: pricing, plans, invoices, refunds, payment failures."
  },
  {
   "name": "support-bot",
   "description": "Customer support tickets, escalations and account questions from customers.",
   "role": "on-call"
  },
  {
   "name": "docs-bot",
   "description": "Product documentation, guides, API reference and release notes."
  }
 ],
